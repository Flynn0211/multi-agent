OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode
# V2 service authentication, when required (takes precedence over Basic Auth)
OPENCODE_SERVER_TOKEN=
OPENCODE_AGENT=build
# Optional provider/model ID; blank uses OpenCode's configured default.
OPENCODE_MODEL=
# Automatically switch on provider quota/rate-limit errors.
OPENCODE_AUTO_FALLBACK=true
# Optional ordered allowlist: provider/model,other-provider/model#variant
# Blank discovers enabled tool-capable chat models in this project's catalog.
OPENCODE_FALLBACK_MODELS=
OPENCODE_MAX_FALLBACKS=4
# No separate LLM key is required: all reasoning uses OpenCode sessions.
OPENAI_API_KEY=
DATA_DIR=./data
MAX_REVISIONS=3
EXECUTION_TIMEOUT=3600
